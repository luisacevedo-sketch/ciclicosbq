<!DOCTYPE html>
<html lang="es">
<head>
<meta charset="UTF-8">
<title>Inventario Cíclico · Altipal</title>
<script src="https://cdnjs.cloudflare.com/ajax/libs/xlsx/0.18.5/xlsx.full.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf/2.5.1/jspdf.umd.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/html2canvas/1.4.1/html2canvas.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/jszip/3.10.1/jszip.min.js"></script>
<!-- Firebase (sincronización en tiempo real entre varias personas/tablets) -->
<script src="https://www.gstatic.com/firebasejs/10.12.2/firebase-app-compat.js"></script>
<script src="https://www.gstatic.com/firebasejs/10.12.2/firebase-firestore-compat.js"></script>
<style>
  :root{
    --azul-oscuro:#003C7E; --azul-claro:#0057B8; --azul-suave:#EAF1FB; --gris:#FFFFFF;
    --rojo:#F8A9A9; --amarillo:#FFF2A8; --azul-alerta:#A9C9F8; --verde:#B7E6B0;
    --diferencia:#FFCC66;
  }
  *{box-sizing:border-box;}
  body{font-family:'Segoe UI',Arial,sans-serif;margin:0;background:var(--azul-suave);color:#1a1a1a;}
  header{background:linear-gradient(90deg,var(--azul-oscuro),var(--azul-claro));color:#fff;padding:14px 18px;display:flex;justify-content:space-between;align-items:center;flex-wrap:wrap;gap:8px;border-bottom:4px solid #fff;}
  header h1{font-size:16px;margin:0;color:#fff;}
  .btn{background:var(--azul-claro);color:#fff;border:none;padding:8px 14px;border-radius:6px;cursor:pointer;font-size:13px;}
  .btn:hover{opacity:.9;}
  .btn.secundario{background:#fff;color:var(--azul-oscuro);border:1px solid var(--azul-oscuro);}
  .btn.rojo{background:#C0392B;}
  .btn.verde{background:#1E8449;}
  main{padding:16px;max-width:1300px;margin:0 auto;}
  .card{background:#fff;border-radius:10px;padding:16px;margin-bottom:16px;box-shadow:0 1px 4px rgba(0,60,126,.12);border-top:3px solid var(--azul-oscuro);}
  .card h2{font-size:15px;color:var(--azul-oscuro);margin-top:0;}
  .fila{display:flex;gap:10px;flex-wrap:wrap;align-items:center;}
  input[type=text],input[type=password],input[type=number],select{padding:6px 8px;border:1px solid #B9CCE6;border-radius:6px;font-size:13px;background:#fff;}
  table{border-collapse:collapse;width:100%;font-size:11px;background:#fff;}
  th,td{border:1px solid #cddcef;padding:4px 5px;text-align:center;}
  .oculto{display:none;}
  #loginOverlay{position:fixed;inset:0;background:rgba(0,60,126,.92);display:flex;align-items:center;justify-content:center;z-index:999;}
  .loginBox{background:#fff;padding:26px;border-radius:10px;width:280px;text-align:center;border-top:4px solid var(--azul-oscuro);}
  .loginBox h2{color:var(--azul-oscuro);}
  .legend{display:flex;gap:14px;font-size:12px;margin:8px 0;flex-wrap:wrap;}
  .legend span{display:inline-flex;align-items:center;gap:5px;}
  .swatch{width:14px;height:14px;border-radius:3px;display:inline-block;border:1px solid #999;}
  .ciclico-item{border:1px solid #cddcef;border-left:4px solid var(--azul-claro);border-radius:8px;padding:10px;cursor:pointer;background:#fff;margin-bottom:8px;}
  .ciclico-item:hover{border-color:var(--azul-claro);background:var(--azul-suave);}
  .cabecera-pdf{border:1px solid #999;font-size:11px;margin-bottom:8px;}
  .cabecera-pdf td{border:1px solid #999;padding:4px 6px;font-weight:bold;background:var(--azul-suave);}
  .cabecera-pdf td.val{font-weight:normal;background:#fff;}
  .tabla-scroll{max-height:60vh;overflow:auto;border:1px solid #cddcef;border-radius:6px;}
  th.headTabla{background:var(--azul-oscuro);color:#fff;position:sticky;top:0;z-index:2;}
  /* Columnas inmovilizadas (Código de artículo, Número de variante, Factor): se quedan
     visibles al desplazarse hacia la derecha para digitar hasta Altura 6, así el operario
     no pierde de vista a qué referencia le corresponde cada conteo. */
  .col-fija{position:sticky;z-index:3;background:#fff;box-shadow:inset -1px 0 0 #B9CCE6;}
  th.col-fija{z-index:4;}
  .registro-input{width:55px;padding:2px;text-align:center;}
  tr.fila-vencimiento td{border-top:none;padding:3px 6px;font-size:11px;}
  tr.fila-altura-extra td{border-top:none;padding:2px 4px;font-size:10px;}
  .venc-input{padding:2px 4px;border:1px solid #B9CCE6;border-radius:4px;font-size:11px;}
  tr.fila-rojo td{background:var(--rojo);}
  tr.fila-amarillo td{background:var(--amarillo);}
  tr.fila-azul td{background:var(--azul-alerta);}
  tr.fila-verde td{background:var(--verde);}
  tr.fila-diferencia td{outline:3px solid var(--diferencia);}
  .dashboard-resumen{font-size:13px;}
  .dashboard-resumen td,.dashboard-resumen th{padding:6px 10px;}
  /* Quita las flechas (spinners) de los campos numéricos: al digitar los conteos
     solo se escriben los números, sin flechas arriba/abajo */
  input[type=number]::-webkit-inner-spin-button,
  input[type=number]::-webkit-outer-spin-button{-webkit-appearance:none;margin:0;}
  input[type=number]{-moz-appearance:textfield;}
  .pdf-pagina{position:relative;}
  .pdf-marca-agua{position:absolute;top:6px;left:10px;font-size:13px;font-weight:bold;color:rgba(0,60,126,.4);letter-spacing:.5px;}
</style>
</head>
<body>

<div id="loginOverlay">
  <div class="loginBox" style="width:300px;">
    <h2>🔒 Acceso restringido</h2>
    <p style="font-size:13px;">Ingresa el usuario y la contraseña del equipo para entrar al conteo compartido</p>
    <div style="text-align:left;font-size:12px;margin-bottom:4px;">Usuario</div>
    <input type="text" id="usuarioInput" placeholder="BARRANQUILLA" style="width:100%;margin-bottom:8px;">
    <div style="text-align:left;font-size:12px;margin-bottom:4px;">Contraseña</div>
    <div style="position:relative;width:100%;">
      <input type="password" id="passInput" placeholder="Contraseña" style="width:100%;padding-right:34px;" onkeydown="if(event.key==='Enter') validarPassword();">
      <button type="button" id="btnTogglePass" onclick="togglePassword()" title="Mostrar/ocultar contraseña"
        style="position:absolute;right:2px;top:2px;bottom:2px;background:none;border:none;cursor:pointer;font-size:15px;padding:0 6px;">👁</button>
    </div>
    <div style="margin-top:12px;"><button class="btn" onclick="validarPassword()">Entrar</button></div>
    <div id="passError" style="color:#C0392B;font-size:12px;margin-top:8px;"></div>
    <p style="font-size:10px;color:#888;margin-top:10px;">Todos los que entren con este mismo usuario ven y editan el mismo conteo en tiempo real. Usa la contraseña del personal de conteo o la de supervisor según tu rol.</p>
  </div>
</div>

<header>
  <h1>📦 Inventario Cíclico · Altipal</h1>
  <div class="fila">
    <button class="btn secundario" id="navCargar" onclick="mostrarVista('vistaCarga')">Cargar archivo</button>
    <button class="btn rojo" id="navLimpiar" onclick="limpiarInformacion()">🗑 Limpiar información</button>
    <button class="btn secundario" id="navCiclicos" onclick="mostrarVista('vistaCiclicos')">Cíclicos</button>
    <button class="btn secundario" id="navDashboard" onclick="mostrarVista('vistaDashboard')">Dashboard / Exportar</button>
    <button class="btn secundario" id="navDiferencias" onclick="abrirVistaDiferencias()">🔎 Diferencias (Supervisor)</button>
    <button class="btn secundario" id="navKPI" onclick="mostrarVista('vistaKPI')">⏱ KPI Conteo</button>
  </div>
  <div class="fila">
    <span id="estadoSync" style="font-size:11px;color:#EAF1FB;"></span>
    <span id="estadoRol" style="font-size:11px;color:#EAF1FB;font-weight:bold;"></span>
  </div>
  <div class="fila" id="bannerSinConexion" style="display:none;background:#B45309;color:#fff;padding:6px 10px;border-radius:6px;font-size:12px;font-weight:bold;">
    📴 Sin conexión a internet — puedes seguir digitando con normalidad. Todo se está guardando en este dispositivo y se sincronizará solo en cuanto vuelva la señal.
  </div>
</header>

<main>

  <!-- ===================== CARGA ===================== -->
  <section id="vistaCarga" class="card">
    <h2>1. Cargar archivo de inventario (.xlsx)</h2>
    <p style="font-size:12px;color:#666;">
      Encabezados esperados: Fecha, Código de artículo, Nombre del producto, Factor, Tipo, Característica 1,
      Característica 2, Sitio, Almacén, Número de lote, Ubicación, Id de pallet, Número de serie, Código de barras,
      Cod. Barras caja, Número de variante, Proveedor, Nombre, DIGA, Disponible, Contado, Cantidad,
      Precio de coste, Importe de coste, Código de disposición de lote, Estado de disposición de lote, Trabajador.
    </p>
    <div class="fila">
      <input type="file" id="archivoInput" accept=".xlsx,.xls,.csv">
      <button class="btn" onclick="cargarArchivo()">Cargar y segmentar</button>
    </div>
    <div id="estadoCarga" style="margin-top:10px;font-size:13px;"></div>
    <p style="font-size:11px;color:#888;margin-top:10px;">Para limpiar toda la información cargada (y empezar un conteo nuevo) usa el botón "🗑 Limpiar información" del menú de arriba. Esa acción también pide la clave del supervisor.</p>
  </section>

  <!-- ===================== CÍCLICOS ===================== -->
  <section id="vistaCiclicos" class="card oculto">
    <h2>2. Cíclicos (Almacén + Ubicación + Nombre)</h2>
    <div class="fila">
      <select id="filtroAlmacen"><option value="">Todos los almacenes</option></select>
      <select id="filtroUbicacion"><option value="">Todas las ubicaciones</option></select>
      <select id="filtroNombre"><option value="">Todos los proveedores</option></select>
      <button class="btn secundario" onclick="aplicarFiltros()">Filtrar</button>
    </div>
    <div id="listaCiclicos" style="margin-top:12px;"></div>
  </section>

  <!-- ===================== CONTEO ===================== -->
  <section id="vistaConteo" class="card oculto">
    <div class="fila" style="justify-content:space-between;">
      <h2 id="tituloConteo">Conteo</h2>
      <div class="fila">
        <button class="btn rojo" id="btnResaltar" onclick="resaltarDiferencias()">Resaltar diferencias</button>
        <button class="btn" id="btnMostrarDif" onclick="mostrarDiferencia()">👁 Mostrar diferencia (supervisor)</button>
      </div>
    </div>

    <table class="cabecera-pdf">
      <tr>
        <td>DIAS FECHA CORTA</td><td class="val"><input type="number" id="hDiasFechaCorta" style="width:60px"></td>
        <td>DIAS AVERIA</td><td class="val"><input type="number" id="hDiasAveria" style="width:60px" value="5"></td>
        <td>DIGA</td><td class="val" id="hDiga"></td>
        <td>CONTEO #1</td>
        <td class="val">
          <select id="hConteo1" style="min-width:160px;"></select>
          <input type="text" id="hConteo1Otro" placeholder="Nombre" class="oculto" style="margin-left:4px;width:110px;">
          <div style="margin-top:4px;font-size:10px;">
            <span id="estadoTiempo1" style="color:#003C7E;font-weight:bold;"></span>
            <button class="btn verde" id="btnIniciarTiempo1" onclick="iniciarConteoPersona(1)" style="padding:2px 6px;font-size:10px;">▶ Iniciar</button>
            <button class="btn rojo oculto" id="btnFinalizarTiempo1" onclick="finalizarConteoPersona(1)" style="padding:2px 6px;font-size:10px;">⏹ Finalizar</button>
          </div>
        </td>
      </tr>
      <tr>
        <td>PROX FECHA CORTA</td><td class="val" id="hProxFechaCorta"></td>
        <td>BUENA FECHA</td><td class="val" id="hBuenaFecha"></td>
        <td>FECHA</td><td class="val" id="hFecha"></td>
        <td>CONTEO #2</td>
        <td class="val">
          <select id="hConteo2" style="min-width:160px;"></select>
          <input type="text" id="hConteo2Otro" placeholder="Nombre" class="oculto" style="margin-left:4px;width:110px;">
          <div style="margin-top:4px;font-size:10px;">
            <span id="estadoTiempo2" style="color:#003C7E;font-weight:bold;"></span>
            <button class="btn verde" id="btnIniciarTiempo2" onclick="iniciarConteoPersona(2)" style="padding:2px 6px;font-size:10px;">▶ Iniciar</button>
            <button class="btn rojo oculto" id="btnFinalizarTiempo2" onclick="finalizarConteoPersona(2)" style="padding:2px 6px;font-size:10px;">⏹ Finalizar</button>
          </div>
        </td>
      </tr>
      <tr>
        <td>CASA COMERCIAL</td><td class="val" id="hCasaComercial"></td>
        <td>ALMACEN</td><td class="val" id="hAlmacen"></td>
        <td>UBICACION</td><td class="val" id="hUbicacion"></td>
        <td>CONTEO #3</td>
        <td class="val">
          <select id="hConteo3" style="min-width:160px;"></select>
          <input type="text" id="hConteo3Otro" placeholder="Nombre" class="oculto" style="margin-left:4px;width:110px;">
          <div style="margin-top:4px;font-size:10px;">
            <span id="estadoTiempo3" style="color:#003C7E;font-weight:bold;"></span>
            <button class="btn verde" id="btnIniciarTiempo3" onclick="iniciarConteoPersona(3)" style="padding:2px 6px;font-size:10px;">▶ Iniciar</button>
            <button class="btn rojo oculto" id="btnFinalizarTiempo3" onclick="finalizarConteoPersona(3)" style="padding:2px 6px;font-size:10px;">⏹ Finalizar</button>
          </div>
        </td>
      </tr>
      <tr>
        <td>SUPERVISOR / COORDINADOR</td>
        <td class="val" colspan="7"><input type="text" id="hSupervisor" placeholder="Supervisor / Coordinador" style="min-width:220px;"></td>
      </tr>
    </table>
    <div id="avisoPolitica" style="font-size:11px;color:var(--azul-oscuro);margin:4px 0;font-weight:bold;"></div>

    <div class="legend">
      <span><span class="swatch" style="background:var(--rojo)"></span> Avería (según días del proveedor)</span>
      <span><span class="swatch" style="background:var(--amarillo)"></span> Corta fecha (según días del proveedor)</span>
      <span><span class="swatch" style="background:var(--verde)"></span> Buena fecha</span>
      <span><span class="swatch" style="outline:3px solid var(--diferencia)"></span> Diferencia Contado (resaltada, sin mostrar el valor)</span>
    </div>
    <p style="font-size:11px;color:#666;margin:4px 0 8px;">Los días de "fecha corta" y "avería" se cargan automáticamente por proveedor (política Altipal). "Resaltar diferencias" solo marca visualmente las filas que no cuadran, sin decir cuánto es la diferencia. Para ver el número exacto de la diferencia hay que usar "👁 Mostrar diferencia", que pide la clave del supervisor.</p>

    <div class="fila" style="margin:8px 0;">
      <input type="text" id="buscarProductoConteo" placeholder="🔎 Buscar por código, variante, nombre, cód. de barras o cód. de barras caja..."
        style="min-width:340px;" oninput="pintarTablaConteo(ciclicos[ciclicoActualId])">
      <span id="contadorBusquedaConteo" style="font-size:11px;color:#666;"></span>
    </div>

    <div class="tabla-scroll">
      <table id="tablaConteo">
        <thead><tr id="headConteo"></tr></thead>
        <tbody id="bodyConteo"></tbody>
      </table>
    </div>
  </section>

  <!-- ===================== DASHBOARD / EXPORTAR ===================== -->
  <section id="vistaDashboard" class="card oculto">
    <h2>3. Dashboard y exportación final</h2>
    <div id="resumenDashboard"></div>
    <div class="fila" style="margin-top:14px;">
      <button class="btn verde" onclick="exportarPDF()">📄 Generar PDF (dashboard + cíclicos) 🔒 supervisor</button>
      <button class="btn verde" onclick="exportarPDFsPorCasaComercial()">📦 PDF separado por casa comercial (ZIP) 🔒 supervisor</button>
      <button class="btn verde" onclick="exportarExcel()">📊 Generar Excel final</button>
      <button class="btn verde" onclick="exportarExcelFechas()">📅 Reporte Excel de fechas y lotes</button>
    </div>
    <p style="font-size:11px;color:#888;margin-top:6px;">El PDF solo se puede descargar con la clave del supervisor. La opción "PDF separado por casa comercial" genera un archivo .zip con un PDF de "Reporte General" (dashboard + faltante/sobrante por proveedor + KPI de tiempos de conteo) y un PDF individual por cada cíclico, nombrado como "Casa comercial · Almacén · Ubicación.pdf".</p>
    <div id="estadoExport" style="margin-top:10px;font-size:13px;"></div>
  </section>

  <!-- ===================== DIFERENCIAS (SOLO SUPERVISOR) ===================== -->
  <section id="vistaDiferencias" class="card oculto">
    <h2>🔎 Referencias con diferencia (acceso de supervisor)</h2>
    <p style="font-size:12px;color:#666;">Muestra, por casa comercial (proveedor), qué referencias tienen diferencia entre lo contado y lo disponible en el sistema.</p>
    <div class="fila" style="margin-bottom:8px;">
      <input type="text" id="filtroCasaDif" placeholder="Buscar por casa comercial...">
      <button class="btn secundario" onclick="pintarTablaDiferencias()">Buscar</button>
    </div>
    <div id="resumenDiferencias" style="font-size:12px;margin-bottom:8px;"></div>
    <div class="tabla-scroll">
      <table id="tablaDiferencias">
        <thead><tr>
          <th class="headTabla">Casa comercial</th>
          <th class="headTabla">Almacén</th>
          <th class="headTabla">Ubicación</th>
          <th class="headTabla">Código de artículo</th>
          <th class="headTabla">Nombre del producto</th>
          <th class="headTabla">Disponible (sistema)</th>
          <th class="headTabla">Contado</th>
          <th class="headTabla">Diferencia (unid.)</th>
          <th class="headTabla">Diferencia ($)</th>
          <th class="headTabla">Validada por supervisor</th>
        </tr></thead>
        <tbody id="bodyDiferencias"></tbody>
      </table>
    </div>
  </section>

  <!-- ===================== KPI DE CONTEO (TIEMPOS) ===================== -->
  <section id="vistaKPI" class="card oculto">
    <h2>⏱ KPI de conteo (tiempos por persona y por cíclico)</h2>
    <p style="font-size:12px;color:#666;">
      Cada responsable (Conteo #1, #2 y #3) tiene botones ▶ Iniciar / ⏹ Finalizar en la pantalla de conteo de cada cíclico.
      Aquí se resume cuánto se demoró cada persona, cuántos cíclicos contó, y cuánto duró el ciclo completo de cada referencia.
    </p>
    <h3 style="font-size:13px;color:var(--azul-oscuro);margin-bottom:6px;">Resumen por persona</h3>
    <div id="resumenKPIPersonas"></div>

    <h3 style="font-size:13px;color:var(--azul-oscuro);margin:16px 0 6px;">Detalle por cíclico</h3>
    <div class="fila" style="margin-bottom:8px;">
      <input type="text" id="filtroKPI" placeholder="Buscar por casa comercial, almacén o ubicación..." style="min-width:300px;" oninput="pintarKPI()">
    </div>
    <div class="tabla-scroll">
      <table id="tablaKPI">
        <thead><tr>
          <th class="headTabla">Casa comercial</th>
          <th class="headTabla">Almacén</th>
          <th class="headTabla">Ubicación</th>
          <th class="headTabla">Conteo #1</th>
          <th class="headTabla">Conteo #2</th>
          <th class="headTabla">Conteo #3</th>
          <th class="headTabla">Duración total del ciclo</th>
          <th class="headTabla">Estado</th>
        </tr></thead>
        <tbody id="bodyKPI"></tbody>
      </table>
    </div>
  </section>

</main>

<!-- Contenedor oculto para renderizar cada cíclico al exportar a PDF -->
<div id="pdfBuffer" style="position:fixed;left:-9999px;top:0;width:1100px;"></div>

<script>
const HEADERS = [
  'Fecha','Código de artículo','Nombre del producto','Factor','Tipo','Característica 1','Característica 2',
  'Sitio','Almacén','Número de lote','Ubicación','Id de pallet','Número de serie','Código de barras',
  'Cod. Barras caja','Número de variante','Proveedor','Nombre','DIGA','Disponible','Contado','Cantidad',
  'Precio de coste','Importe de coste','Código de disposición de lote','Estado de disposición de lote','Trabajador'
];
const NUM_REGISTROS = 10;
const REGISTRO_LABELS = ['PICKING','PICKING2','ALTURA1','ALTURA2','ALTURA3','ALTURA4','ALTURA5','ALTURA6','ALTURA7','ALTURA8'];
const SUPERVISOR_PASS = 'ALTIPAL_SUP*'; // clave del supervisor para validar diferencias (cámbiala aquí si lo necesitas)

// Pide la clave del supervisor para una acción puntual (cargar archivo, limpiar info, exportar PDF, etc.).
// Si ya se inició sesión como supervisor (rolActual==='supervisor'), no vuelve a pedirla.
async function requiereClaveSupervisor(mensaje){
  if(rolActual === 'supervisor') return true;
  const clave = prompt(mensaje);
  if(clave === null) return false; // canceló
  if(clave !== SUPERVISOR_PASS){
    alert('Clave incorrecta. Solo el supervisor/coordinador puede realizar esta acción.');
    return false;
  }
  return true;
}

const FECHA_CORTA_PROVEEDORES = {
  "ABBOTT LABORATORIES DE COLOMBIA S A S": {
    "buenaACorta": 30,
    "cortaAAveria": 8
  },
  "ABURRA LTDA": {
    "buenaACorta": 30,
    "cortaAAveria": 5
  },
  "ADMINISTRACION DE RECURSOS Y OPORTUNIDADES S.A.": {
    "buenaACorta": 20,
    "cortaAAveria": 5
  },
  "AGRICOLA HIMALAYA S.A.": {
    "buenaACorta": 90,
    "cortaAAveria": 90
  },
  "ALPINA PRODUCTOS ALIMENTICIOS S.A": {
    "buenaACorta": 20,
    "cortaAAveria": 4
  },
  "AZUL -K": {
    "buenaACorta": null,
    "cortaAAveria": null
  },
  "BIC": {
    "buenaACorta": null,
    "cortaAAveria": null
