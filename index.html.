    return;
  }
  if(!(await requiereClaveSupervisor('Clave del supervisor para limpiar toda la información cargada:'))) return;
  if(!confirm('Esto borrará TODOS los cíclicos y conteos cargados (en este dispositivo y, si hay sincronización, en la nube). ¿Continuar?')) return;

  const idsAntiguos = Object.keys(ciclicos);

