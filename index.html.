  document.getElementById('estadoCarga').innerText = 'Información limpiada. Carga un nuevo archivo cuando quieras.';
  document.getElementById('archivoInput').value = '';
  llenarFiltros();
  renderListaCiclicos([]);
  mostrarVista('vistaCarga');
  try{ localStorage.removeItem(CLAVE_RESPALDO_LOCAL); }catch(e){}

  // Si hay sincronización en la nube, borra también los documentos existentes.
  if(firebaseListo() && db && idsAntiguos.length){
    const batch = db.batch();
    idsAntiguos.forEach(id=>{
      const ref = db.collection('sesiones').doc(sesionId).collection('ciclicos').doc(idDoc(id));
      batch.delete(ref);
    });
    batch.commit().catch(err=> console.error('Error limpiando la nube:', err));
  }
}

