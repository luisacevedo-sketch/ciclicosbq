// Resumen de KPI por persona: cuántos cíclicos contó, tiempo total y tiempo promedio.
function calcularKPIPorPersona(){
  const mapa = {};
  Object.values(ciclicos).forEach(c=>{
    asegurarTiempos(c);
    [1,2,3].forEach(n=>{
      c.tiempos[n].historial.forEach(s=>{
        const nombre = s.persona || '(Sin nombre)';
        if(!mapa[nombre]) mapa[nombre] = { persona: nombre, conteos:0, segundosTotal:0 };
        mapa[nombre].conteos++;
        mapa[nombre].segundosTotal += (s.segundos||0);
      });
    });
  });
  return Object.values(mapa)
    .map(p=> ({...p, promedioSegundos: p.conteos ? p.segundosTotal/p.conteos : 0}))
    .sort((a,b)=> b.segundosTotal - a.segundosTotal);
}

// Duración total del ciclo de una referencia: desde que arrancó el primer
// conteo (de los 3) hasta que terminó el último.
function calcularDuracionCiclo(c){
  asegurarTiempos(c);
  const sesiones = [1,2,3].flatMap(n=> c.tiempos[n].historial);
  if(!sesiones.length) return null;
  const inicios = sesiones.map(s=> new Date(s.inicio).getTime());
  const fines = sesiones.map(s=> new Date(s.fin).getTime());
  return Math.round((Math.max(...fines) - Math.min(...inicios))/1000);
}

