function pintarTablaDiferencias(){
  const filtro = (document.getElementById('filtroCasaDif').value || '').trim().toUpperCase();
  const body = document.getElementById('bodyDiferencias');
  let filas = [];

  Object.values(ciclicos).forEach(c=>{
    if(filtro && !String(c.nombre||'').toUpperCase().includes(filtro)) return;
    c.filas.forEach(f=>{
      const registros = f._registros || Array(NUM_REGISTROS).fill('');
      const total = registros.reduce((a,v)=> a + (Number(v)||0), 0);
      const disponible = Number(f['Disponible'])||0;
      const dif = total - disponible;
      if(dif === 0) return;
      const precio = Number(f['Precio de coste'])||0;
      filas.push({
        casa: c.nombre, almacen: c.almacen, ubicacion: c.ubicacion,
        codigo: f['Código de artículo'], nombreProducto: f['Nombre del producto'],
        disponible, total, dif, difDinero: dif*precio,
        validada: c._diferenciasReveladas ? (c._supervisorRevelador||'Sí') : 'No'
      });
    });
  });

  document.getElementById('resumenDiferencias').innerText =
    `${filas.length} referencia(s) con diferencia encontradas.`;

  if(!filas.length){
    body.innerHTML = `<tr><td colspan="10">No hay diferencias para mostrar.</td></tr>`;
    return;
  }

  body.innerHTML = filas.map(r=>`
    <tr>
      <td>${r.casa}</td><td>${r.almacen}</td><td>${r.ubicacion}</td>
      <td>${r.codigo}</td><td style="text-align:left;">${r.nombreProducto}</td>
      <td>${r.disponible}</td><td>${r.total}</td>
      <td style="color:${r.dif>0?'#1E8449':'#C0392B'};font-weight:bold;">${r.dif>0?'+':''}${r.dif}</td>
      <td>$${r.difDinero.toLocaleString('es-CO',{maximumFractionDigits:0})}</td>
      <td>${r.validada}</td>
    </tr>`).join('');
}

