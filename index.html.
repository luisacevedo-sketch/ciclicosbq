// "Resaltar diferencias": solo marca visualmente las filas que no cuadran (contado vs.
// disponible), SIN mostrar el número de la diferencia. No requiere clave de supervisor,
// porque no revela ningún valor sensible, solo indica que "algo no cuadra" en esa fila.
function resaltarDiferencias(){
  const c = ciclicos[ciclicoActualId];
  c._resaltado = !c._resaltado;
  pintarTablaConteo(c);
  actualizarBotonResaltar(c);
  guardarCiclicoEnNube(c);
}

// "Mostrar diferencia": revela el número exacto de la diferencia (unidades) en la fila
// resaltada. Esto SÍ requiere la clave del supervisor, porque expone el Disponible/valor real.
async function mostrarDiferencia(){
  const c = ciclicos[ciclicoActualId];

  if(c._diferenciasReveladas){
    alert('La diferencia de esta hoja ya fue revelada por el supervisor (' + (c._supervisorRevelador||'') + ').');
    return;
  }

  if(!(await requiereClaveSupervisor('Clave del supervisor para mostrar el número exacto de la diferencia en esta hoja cíclica:'))) return;

  c._diferenciasReveladas = true;
  c._supervisorRevelador = document.getElementById('hSupervisor').value || 'Supervisor';
  // Al mostrar la diferencia también se activa el resaltado, para que se vea de una vez cuál fila es.
  c._resaltado = true;
  pintarTablaConteo(c);
  actualizarBotonResaltar(c);
  guardarCiclicoEnNube(c);
}

function actualizarBotonResaltar(c){
  const btn = document.getElementById('btnResaltar');
  const btnDif = document.getElementById('btnMostrarDif');
  if(btn){
    if(c._resaltado){
      btn.innerText = '✔ Diferencias resaltadas';
      btn.classList.remove('rojo');
      btn.classList.add('verde');
    } else {
      btn.innerText = 'Resaltar diferencias';
      btn.classList.remove('verde');
      btn.classList.add('rojo');
    }
  }
  if(btnDif){
    btnDif.innerText = c._diferenciasReveladas ? '✔ Diferencia mostrada' : '👁 Mostrar diferencia (supervisor)';
  }
}

/* ---------------- DASHBOARD ---------------- */
function calcularResumen(){
  let totalCiclicos = 0, totalReferencias = 0, totalDiferencias = 0, totalUnidadesDif = 0, totalDineroDif = 0;
  Object.values(ciclicos).forEach(c=>{
    totalCiclicos++;
    c.filas.forEach(f=>{
      totalReferencias++;
      const registros = f._registros || Array(NUM_REGISTROS).fill('');
      const total = registros.reduce((a,v)=> a + (Number(v)||0), 0);
      const disponible = Number(f['Disponible'])||0;
      const dif = total - disponible;
      if(dif !== 0){
        totalDiferencias++;
        totalUnidadesDif += dif;
        const precio = Number(f['Precio de coste'])||0;
        totalDineroDif += dif * precio;
      }
    });
  });
  return {totalCiclicos, totalReferencias, totalDiferencias, totalUnidadesDif, totalDineroDif};
}

// Agrupa el faltante/sobrante por proveedor (casa comercial), sumando todas las
// referencias de todos los cíclicos que pertenecen a ese proveedor.
function calcularResumenPorProveedor(){
  const mapa = {};
  Object.values(ciclicos).forEach(c=>{
    const proveedor = c.nombre || '(Sin proveedor)';
    if(!mapa[proveedor]){
      mapa[proveedor] = {proveedor, unidadesContadas:0, unidadesDisponibles:0, valorContado:0, valorDisponible:0, tieneTroque:false};
    }
    c.filas.forEach(f=>{
      const registros = f._registros || Array(NUM_REGISTROS).fill('');
      const contado = registros.reduce((a,v)=> a + (Number(v)||0), 0);
      const disponible = Number(f['Disponible'])||0;
      const precio = Number(f['Precio de coste'])||0;
      mapa[proveedor].unidadesContadas += contado;
      mapa[proveedor].unidadesDisponibles += disponible;
      mapa[proveedor].valorContado += contado * precio;
      mapa[proveedor].valorDisponible += disponible * precio;

      // TROQUE: si en el lote digitado de cualquier columna (PICKING/PICKING2/ALTURA1-8)
      // el operario escribió "TROQUE", se marca el proveedor para resaltarlo en el PDF.
      const lotes = f._registrosLote || [];
      if(lotes.some(l => String(l||'').toUpperCase().includes('TROQUE'))){
        mapa[proveedor].tieneTroque = true;
      }
    });
  });
  return Object.values(mapa)
    .map(p=>({
      ...p,
      diferenciaUnidades: p.unidadesContadas - p.unidadesDisponibles,
      diferenciaValor: p.valorContado - p.valorDisponible
    }))
    .sort((a,b)=> a.proveedor.localeCompare(b.proveedor, 'es'));
}

