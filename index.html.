  const resumenProveedores = calcularResumenPorProveedor();
  if(resumenProveedores.length){
    const totalPagProv = Math.max(1, Math.ceil(resumenProveedores.length / PROVEEDORES_POR_HOJA_PDF));
    for(let p=0; p<totalPagProv; p++){
      const chunk = resumenProveedores.slice(p*PROVEEDORES_POR_HOJA_PDF, (p+1)*PROVEEDORES_POR_HOJA_PDF);
      buffer.innerHTML = renderResumenProveedoresHTML(chunk, p+1, totalPagProv);
      canvas = await html2canvas(buffer, {scale:2});
      addCanvasPage(pdf, canvas, false);
    }
  }

  // Página(s) de KPI: tiempos por persona y detalle por cíclico
  buffer.style.width = '1100px';
  const kpiPersonas = calcularKPIPorPersona();
  buffer.innerHTML = renderResumenKPIPersonasHTML(kpiPersonas);
  canvas = await html2canvas(buffer, {scale:2});
  addCanvasPage(pdf, canvas, false);

  const ciclicosParaKPI = Object.values(ciclicos);
  ciclicosParaKPI.forEach(asegurarTiempos);
  if(ciclicosParaKPI.length){
    const totalPagKPI = Math.max(1, Math.ceil(ciclicosParaKPI.length / CICLICOS_POR_HOJA_KPI_PDF));
    for(let p=0; p<totalPagKPI; p++){
      const chunk = ciclicosParaKPI.slice(p*CICLICOS_POR_HOJA_KPI_PDF, (p+1)*CICLICOS_POR_HOJA_KPI_PDF);
      buffer.innerHTML = renderDetalleKPIHTML(chunk, p+1, totalPagKPI);
      canvas = await html2canvas(buffer, {scale:2});
      addCanvasPage(pdf, canvas, false);
    }
  }

  // Páginas siguientes: detalle de cada cíclico (con columnas Picking/Altura1-6)
  buffer.style.width = '1650px';
  const ids = Object.keys(ciclicos);
  for(let k=0; k<ids.length; k++){
    const c = ciclicos[ids[k]];
    if(!c.filas.length) continue;

    // Cada cíclico se reparte en varias hojas (páginas) de FILAS_POR_HOJA_PDF filas,
    // cada una con marca de agua (nombre del cíclico + "Hoja X de Y") en la esquina
    // superior izquierda, para saber cuántas hojas tiene ese cíclico.
    const totalPaginas = Math.max(1, Math.ceil(c.filas.length / FILAS_POR_HOJA_PDF));
    for(let p=0; p<totalPaginas; p++){
      const chunk = c.filas.slice(p*FILAS_POR_HOJA_PDF, (p+1)*FILAS_POR_HOJA_PDF);
      buffer.innerHTML = renderCiclicoPaginaHTML(c, chunk, p+1, totalPaginas);
      canvas = await html2canvas(buffer, {scale:2});
      addCanvasPage(pdf, canvas, false);
    }
    document.getElementById('estadoExport').innerText = `Generando PDF... (${k+1}/${ids.length} cíclicos)`;
  }

  pdf.save('Dashboard_Inventario_Ciclico_Altipal.pdf');
  document.getElementById('estadoExport').innerText = 'PDF generado y descargado.';
  buffer.innerHTML = '';
  buffer.style.width = '1100px';
}

// Convierte un texto en un nombre de archivo válido (sin caracteres prohibidos
// en Windows/Mac: \ / : * ? " < > |), para poder usarlo como nombre dentro del ZIP.
function nombreArchivoValido(texto){
  return String(texto).replace(/[\\/:*?"<>|]/g, '-').replace(/\s+/g,' ').trim();
}

// Genera un archivo .zip que contiene: un PDF "Reporte General" (dashboard + faltante/
// sobrante por proveedor) y un PDF individual por cada cíclico (casa comercial + almacén
// + ubicación), nombrado exactamente así, ej: "BRINSA S.A. · Almacén 12001 · Ubicación A0111.pdf".
async function exportarPDFsPorCasaComercial(){
  if(!Object.keys(ciclicos).length){ alert('Primero carga un archivo.'); return; }

  if(!(await requiereClaveSupervisor('Este reporte solo lo puede descargar el supervisor. Ingresa la clave del supervisor:'))) return;

  document.getElementById('estadoExport').innerText = 'Generando PDFs separados por casa comercial...';
  const { jsPDF } = window.jspdf;
  const buffer = document.getElementById('pdfBuffer');
  const zip = new JSZip();

  // ---- Reporte General: dashboard resumen + faltante/sobrante por proveedor ----
  buffer.style.width = '1100px';
  const pdfGeneral = new jsPDF('l', 'pt', 'a4');
  const r = calcularResumen();
  buffer.innerHTML = `<div style="padding:20px;font-family:Arial;">
    <h1 style="color:#003C7E;">Dashboard Inventario Cíclico - Altipal</h1>
    <table class="dashboard-resumen" style="border-collapse:collapse;">
      <tr><th style="border:1px solid #999;padding:6px;">Cíclicos</th><td style="border:1px solid #999;padding:6px;">${r.totalCiclicos}</td></tr>
      <tr><th style="border:1px solid #999;padding:6px;">Referencias totales</th><td style="border:1px solid #999;padding:6px;">${r.totalReferencias}</td></tr>
      <tr><th style="border:1px solid #999;padding:6px;">Líneas con diferencia</th><td style="border:1px solid #999;padding:6px;">${r.totalDiferencias}</td></tr>
      <tr><th style="border:1px solid #999;padding:6px;">Diferencia en unidades</th><td style="border:1px solid #999;padding:6px;">${r.totalUnidadesDif}</td></tr>
      <tr><th style="border:1px solid #999;padding:6px;">Diferencia en dinero</th><td style="border:1px solid #999;padding:6px;">$${r.totalDineroDif.toLocaleString('es-CO')}</td></tr>
    </table>
  </div>`;
  let canvas = await html2canvas(buffer, {scale:2});
  addCanvasPage(pdfGeneral, canvas, true);

  const resumenProveedores = calcularResumenPorProveedor();
  if(resumenProveedores.length){
    const totalPagProv = Math.max(1, Math.ceil(resumenProveedores.length / PROVEEDORES_POR_HOJA_PDF));
    for(let p=0; p<totalPagProv; p++){
      const chunk = resumenProveedores.slice(p*PROVEEDORES_POR_HOJA_PDF, (p+1)*PROVEEDORES_POR_HOJA_PDF);
      buffer.innerHTML = renderResumenProveedoresHTML(chunk, p+1, totalPagProv);
      canvas = await html2canvas(buffer, {scale:2});
      addCanvasPage(pdfGeneral, canvas, false);
    }
  }

  // Página(s) de KPI: tiempos por persona y detalle por cíclico
  buffer.style.width = '1100px';
  const kpiPersonas = calcularKPIPorPersona();
  buffer.innerHTML = renderResumenKPIPersonasHTML(kpiPersonas);
  canvas = await html2canvas(buffer, {scale:2});
  addCanvasPage(pdfGeneral, canvas, false);

  const ciclicosParaKPI = Object.values(ciclicos);
  ciclicosParaKPI.forEach(asegurarTiempos);
  if(ciclicosParaKPI.length){
    const totalPagKPI = Math.max(1, Math.ceil(ciclicosParaKPI.length / CICLICOS_POR_HOJA_KPI_PDF));
    for(let p=0; p<totalPagKPI; p++){
      const chunk = ciclicosParaKPI.slice(p*CICLICOS_POR_HOJA_KPI_PDF, (p+1)*CICLICOS_POR_HOJA_KPI_PDF);
      buffer.innerHTML = renderDetalleKPIHTML(chunk, p+1, totalPagKPI);
      canvas = await html2canvas(buffer, {scale:2});
      addCanvasPage(pdfGeneral, canvas, false);
    }
  }

  zip.file('Reporte General.pdf', pdfGeneral.output('blob'));

  // ---- Un PDF individual por cada cíclico (casa comercial + almacén + ubicación) ----
  buffer.style.width = '1650px';
  const ids = Object.keys(ciclicos);
  const nombresUsados = {}; // evita sobrescribir si dos cíclicos comparten exactamente el mismo nombre de archivo

  for(let k=0; k<ids.length; k++){
    const c = ciclicos[ids[k]];
    if(!c.filas.length) continue;

    const pdfCiclico = new jsPDF('l', 'pt', 'a4');
    const totalPaginas = Math.max(1, Math.ceil(c.filas.length / FILAS_POR_HOJA_PDF));
    for(let p=0; p<totalPaginas; p++){
      const chunk = c.filas.slice(p*FILAS_POR_HOJA_PDF, (p+1)*FILAS_POR_HOJA_PDF);
      buffer.innerHTML = renderCiclicoPaginaHTML(c, chunk, p+1, totalPaginas);
      canvas = await html2canvas(buffer, {scale:2});
      addCanvasPage(pdfCiclico, canvas, p===0);
    }

    let nombreBase = nombreArchivoValido(`${c.nombre} · Almacén ${c.almacen} · Ubicación ${c.ubicacion}`);
    if(nombresUsados[nombreBase] !== undefined){
      nombresUsados[nombreBase]++;
      nombreBase += ` (${nombresUsados[nombreBase]})`;
    } else {
      nombresUsados[nombreBase] = 0;
    }

    zip.file(nombreBase + '.pdf', pdfCiclico.output('blob'));
    document.getElementById('estadoExport').innerText = `Generando PDFs... (${k+1}/${ids.length} cíclicos)`;
  }

  document.getElementById('estadoExport').innerText = 'Comprimiendo archivos en el .zip...';
  const zipBlob = await zip.generateAsync({type:'blob'});

  const url = URL.createObjectURL(zipBlob);
  const enlace = document.createElement('a');
  enlace.href = url;
  enlace.download = 'Reportes_Ciclicos_Altipal_' + new Date().toISOString().slice(0,10) + '.zip';
  document.body.appendChild(enlace);
  enlace.click();
  document.body.removeChild(enlace);
  URL.revokeObjectURL(url);

  document.getElementById('estadoExport').innerText = 'ZIP con PDFs separados por casa comercial generado y descargado.';
  buffer.innerHTML = '';
  buffer.style.width = '1100px';
}

// Tabla de faltante/sobrante por proveedor: unidades contadas, unidades disponibles,
// diferencia en unidades, y lo mismo en dinero (valor contado, valor disponible, diferencia $).
function renderResumenProveedoresHTML(chunk, paginaActual, totalPaginas){
  const fmt = n => '$' + (Number(n)||0).toLocaleString('es-CO',{maximumFractionDigits:0});
  const filasHtml = chunk.map(p=>{
    const colorUnid = p.diferenciaUnidades !== 0 ? 'color:#C0392B;font-weight:bold;' : '';
    const colorVal = p.diferenciaValor !== 0 ? 'color:#C0392B;font-weight:bold;' : '';
    const filaBg = p.tieneTroque ? 'background:#FFE3B3;' : 'background:#fff;';
    const celdaTroque = p.tieneTroque
      ? '<span style="background:#F39C12;color:#fff;font-weight:bold;padding:2px 8px;border-radius:4px;">TROQUE</span>'
      : '';
    return `<tr style="${filaBg}">
      <td style="text-align:left;">${p.proveedor}</td>
      <td>${p.unidadesContadas}</td><td>${p.unidadesDisponibles}</td>
      <td style="${colorUnid}">${p.diferenciaUnidades>0?'+':''}${p.diferenciaUnidades}</td>
      <td>${fmt(p.valorContado)}</td><td>${fmt(p.valorDisponible)}</td>
      <td style="${colorVal}">${fmt(p.diferenciaValor)}</td>
      <td>${celdaTroque}</td>
    </tr>`;
  }).join('');

  return `<div class="pdf-pagina" style="padding:20px;font-family:Arial;font-size:12px;">
    <div class="pdf-marca-agua">FALTANTE / SOBRANTE POR PROVEEDOR · Hoja ${paginaActual} de ${totalPaginas}</div>
    <h1 style="color:#003C7E;margin-top:26px;">Faltante / sobrante de unidades por proveedor</h1>
    <table style="border-collapse:collapse;width:100%;">
      <thead><tr>
        <th style="border:1px solid #999;background:#003C7E;color:#fff;padding:6px;text-align:left;">Proveedor (casa comercial)</th>
        <th style="border:1px solid #999;background:#003C7E;color:#fff;padding:6px;">Unid. contadas</th>
        <th style="border:1px solid #999;background:#003C7E;color:#fff;padding:6px;">Unid. disponibles</th>
        <th style="border:1px solid #999;background:#003C7E;color:#fff;padding:6px;">Diferencia (unid.)</th>
        <th style="border:1px solid #999;background:#003C7E;color:#fff;padding:6px;">Valor contado</th>
        <th style="border:1px solid #999;background:#003C7E;color:#fff;padding:6px;">Valor disponible</th>
        <th style="border:1px solid #999;background:#003C7E;color:#fff;padding:6px;">Diferencia ($)</th>
        <th style="border:1px solid #999;background:#003C7E;color:#fff;padding:6px;">Troque</th>
      </tr></thead>
      <tbody>${filasHtml}</tbody>
    </table>
  </div>`;
}


function addCanvasPage(pdf, canvas, esPrimera){
  const imgData = canvas.toDataURL('image/png');
  const pageW = pdf.internal.pageSize.getWidth();
  const pageH = pdf.internal.pageSize.getHeight();
  const ratio = Math.min(pageW / canvas.width, pageH / canvas.height);
  const w = canvas.width * ratio, h = canvas.height * ratio;
  if(!esPrimera) pdf.addPage();
  pdf.addImage(imgData, 'PNG', (pageW-w)/2, 20, w, h);
}

// Estructura de la tabla del PDF (una fila por referencia):
// Almacén, Ubicación, Casa comercial (proveedor), Código de artículo, Nombre del producto,
// PICKING/PICKING2 y ALTURA1-8 (lo digitado en cada columna), Unidades contadas, Unidades disponibles,
// Valor contado, Valor disponible, Diferencia (unidades) y Diferencia ($).
function renderCiclicoPaginaHTML(c, filasChunk, paginaActual, totalPaginas){
  const cols = ['Almacén','Ubicación','Casa comercial','Código de artículo','Nombre del producto']
    .concat(REGISTRO_LABELS)
    .concat(['Unid. contadas','Unid. disponibles','Valor contado','Valor disponible','Diferencia (unid.)','Diferencia ($)']);

  const fmt = n => '$' + (Number(n)||0).toLocaleString('es-CO',{maximumFractionDigits:0});

  let filasHtml = '';
  filasChunk.forEach(f=>{
    const registros = f._registros || Array(NUM_REGISTROS).fill('');
    const contado = registros.reduce((a,v)=> a + (Number(v)||0), 0);
    const disponible = Number(f['Disponible'])||0;
    const precio = Number(f['Precio de coste'])||0;
    const dif = contado - disponible;
    const valorContado = contado * precio;
    const valorDisponible = disponible * precio;
    const difDinero = dif * precio;
    const colorDif = dif !== 0 ? 'color:#C0392B;font-weight:bold;' : '';
    const registrosHtml = registros.map(v=>`<td>${v!==''&&v!==null&&v!==undefined ? v : ''}</td>`).join('');
    filasHtml += `<tr style="background:#fff;">
      <td>${f['Almacén']}</td><td>${f['Ubicación']}</td><td style="text-align:left;">${c.nombre}</td>
      <td>${f['Código de artículo']}</td><td style="text-align:left;">${f['Nombre del producto']}</td>
      ${registrosHtml}
      <td><b>${contado}</b></td><td>${disponible}</td>
      <td>${fmt(valorContado)}</td><td>${fmt(valorDisponible)}</td>
      <td style="${colorDif}">${dif>0?'+':''}${dif}</td>
      <td style="${colorDif}">${fmt(difDinero)}</td>
    </tr>`;
  });

  return `<div class="pdf-pagina" style="padding:16px;font-family:Arial;font-size:11px;">
    <div class="pdf-marca-agua">${(c.nombre||'').toUpperCase()} · Hoja ${paginaActual} de ${totalPaginas}</div>
    <table style="border-collapse:collapse;width:100%;margin:26px 0 8px;">
      <tr>
        <td style="border:1px solid #999;background:#EAF1FB;font-weight:bold;padding:4px;">DIAS FECHA CORTA</td><td style="border:1px solid #999;padding:4px;">${c.header.diasFechaCorta||''}</td>
        <td style="border:1px solid #999;background:#EAF1FB;font-weight:bold;padding:4px;">DIAS AVERIA</td><td style="border:1px solid #999;padding:4px;">${c.header.diasAveria||''}</td>
        <td style="border:1px solid #999;background:#EAF1FB;font-weight:bold;padding:4px;">DIGA</td><td style="border:1px solid #999;padding:4px;">${c.header.diga||''}</td>
        <td style="border:1px solid #999;background:#EAF1FB;font-weight:bold;padding:4px;">CONTEO #1</td><td style="border:1px solid #999;padding:4px;">${c.header.conteo1||''}</td>
      </tr>
      <tr>
        <td style="border:1px solid #999;background:#EAF1FB;font-weight:bold;padding:4px;">CASA COMERCIAL</td><td style="border:1px solid #999;padding:4px;" colspan="3">${c.nombre}</td>
        <td style="border:1px solid #999;background:#EAF1FB;font-weight:bold;padding:4px;">ALMACEN</td><td style="border:1px solid #999;padding:4px;">${c.almacen}</td>
        <td style="border:1px solid #999;background:#EAF1FB;font-weight:bold;padding:4px;">UBICACION</td><td style="border:1px solid #999;padding:4px;">${c.ubicacion}</td>
      </tr>
      <tr>
        <td style="border:1px solid #999;background:#EAF1FB;font-weight:bold;padding:4px;">CONTEO #2</td><td style="border:1px solid #999;padding:4px;">${c.header.conteo2||''}</td>
        <td style="border:1px solid #999;background:#EAF1FB;font-weight:bold;padding:4px;">CONTEO #3</td><td style="border:1px solid #999;padding:4px;">${c.header.conteo3||''}</td>
        <td style="border:1px solid #999;background:#EAF1FB;font-weight:bold;padding:4px;">SUPERVISOR/COORD.</td><td style="border:1px solid #999;padding:4px;" colspan="3">${c.header.supervisor||''}</td>
      </tr>
    </table>
    <table style="border-collapse:collapse;width:100%;">
      <thead><tr>${cols.map(h=>`<th style="border:1px solid #999;background:#003C7E;color:#fff;padding:4px;">${h}</th>`).join('')}</tr></thead>
      <tbody>${filasHtml}</tbody>
    </table>
  </div>`;
}

/* ---------------- EXPORTAR EXCEL ---------------- */
function exportarExcel(){
  // Usa los cíclicos en memoria (ya sea porque tú cargaste el archivo, o porque
  // llegaron sincronizados desde la nube gracias a otra persona del equipo).
  const todasLasFilas = Object.values(ciclicos).flatMap(c=> c.filas.map(f=> ({fila:f, c})));
  if(!todasLasFilas.length){ alert('Primero carga un archivo (o espera a que llegue la sincronización).'); return; }

  const salida = todasLasFilas.map(({fila:row, c})=>{
    let contado = 0;
    if(row._registros){
      contado = row._registros.reduce((a,v)=> a + (Number(v)||0), 0);
    }
    const disponible = Number(row['Disponible'])||0;
    const diferenciaUnidades = contado - disponible;
    const precio = Number(row['Precio de coste'])||0;
    const diferenciaDinero = diferenciaUnidades * precio;

    const nueva = {...row};
    delete nueva._registros; delete nueva._registrosFecha; delete nueva._registrosLote;
    delete nueva._marcarDiferencia;
    nueva['Contado'] = contado;
    nueva['Cantidad'] = diferenciaUnidades;
    nueva['Importe de coste'] = diferenciaDinero;
    nueva['Diferencia mostrada por supervisor'] = c && c._diferenciasReveladas ? (c._supervisorRevelador||'Sí') : '';
    return nueva;
  });

  const ws = XLSX.utils.json_to_sheet(salida, {header: HEADERS.concat(['Diferencia mostrada por supervisor'])});
  const wb = XLSX.utils.book_new();
  XLSX.utils.book_append_sheet(wb, ws, 'Inventario Final');
  XLSX.writeFile(wb, 'Inventario_Ciclico_Final_Altipal.xlsx');
  document.getElementById('estadoExport').innerText = 'Excel generado y descargado.';
}

/* ---------------- EXPORTAR EXCEL DE FECHAS Y LOTES ---------------- */
// Un producto puede tener varias fechas de vencimiento y lotes (uno por cada
// columna PICKING/PICKING2/ALTURA1-8 donde se contó algo). Este reporte pone cada
// combinación de fecha+lote en su propia fila, una debajo de la otra.
function exportarExcelFechas(){
  const filasSalida = [];

  Object.values(ciclicos).forEach(c=>{
    c.filas.forEach(f=>{
      const registros = f._registros || Array(NUM_REGISTROS).fill('');
      const registrosFecha = f._registrosFecha || Array(NUM_REGISTROS).fill('');
      const registrosLote = f._registrosLote || Array(NUM_REGISTROS).fill('');

      registros.forEach((valor, ridx)=>{
        const tieneValor = valor !== '' && valor !== null && valor !== undefined;
        const tieneFecha = !!registrosFecha[ridx];
        const tieneLote = !!registrosLote[ridx];
        if(!tieneValor && !tieneFecha && !tieneLote) return; // columna sin nada digitado, se omite

        filasSalida.push({
          'Almacén': f['Almacén'],
          'Código de artículo': f['Código de artículo'],
          'Número de variante': f['Número de variante'],
          'Nombre del producto': f['Nombre del producto'],
          'Columna (Picking/Altura)': REGISTRO_LABELS[ridx],
          'Contado': tieneValor ? Number(valor)||0 : '',
          'Fecha de vencimiento': registrosFecha[ridx] || '',
          'Lote': registrosLote[ridx] || ''
        });
      });
    });
  });

  if(!filasSalida.length){
    alert('No hay fechas/lotes digitados todavía para generar este reporte.');
    return;
  }

  const ws = XLSX.utils.json_to_sheet(filasSalida, {
    header: ['Almacén','Código de artículo','Número de variante','Nombre del producto','Columna (Picking/Altura)','Contado','Fecha de vencimiento','Lote']
  });
  const wb = XLSX.utils.book_new();
  XLSX.utils.book_append_sheet(wb, ws, 'Fechas y Lotes');
  XLSX.writeFile(wb, 'Reporte_Fechas_Lotes_Altipal.xlsx');
  document.getElementById('estadoExport').innerText = 'Excel de fechas y lotes generado y descargado.';
}
