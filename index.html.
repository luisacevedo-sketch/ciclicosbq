async function cargarArchivo(){
  const input = document.getElementById('archivoInput');
  const file = input.files[0];
  if(!file){ alert('Selecciona un archivo primero.'); return; }

  if(!(await requiereClaveSupervisor('Clave del supervisor para subir el archivo de inventario:'))) return;

  document.getElementById('estadoCarga').innerText = 'Procesando archivo...';

  const reader = new FileReader();
  reader.onload = e=>{
    const wb = XLSX.read(e.target.result, {type:'binary', cellDates:true});
    const sheet = wb.Sheets[wb.SheetNames[0]];
    const json = XLSX.utils.sheet_to_json(sheet, {defval:''});
    rawRows = json;
    segmentarCiclicos();
    document.getElementById('estadoCarga').innerText =
      `Cargado: ${rawRows.length} filas → ${Object.keys(ciclicos).length} cíclicos generados.` +
      (firebaseListo() ? ' Subiendo a la sesión compartida...' : '');
    llenarFiltros();
    mostrarVista('vistaCiclicos');
    renderListaCiclicos(Object.values(ciclicos));
    subirTodosLosCiclicosANube();
  };
  reader.readAsBinaryString(file);
}

function buscarFechaCorta(nombre, proveedor){
  const claves = [nombre, proveedor].map(v=>String(v||'').trim().toUpperCase()).filter(Boolean);
  for(const clave of claves){
    if(FECHA_CORTA_PROVEEDORES[clave]) return FECHA_CORTA_PROVEEDORES[clave];
  }
  return null;
}

function segmentarCiclicos(){
  ciclicos = {};
  rawRows.forEach(row=>{
    const almacen = row['Almacén'];
    const ubicacion = row['Ubicación'];
    const nombre = row['Nombre'];
    if(!almacen && !ubicacion && !nombre) return;
    const id = [nombre, almacen, ubicacion].map(v=>String(v||'').trim()).join('||');
    if(!ciclicos[id]){
      const politica = buscarFechaCorta(nombre, row['Proveedor']);
      ciclicos[id] = {
        id, almacen, ubicacion, nombre, filas:[],
        header:{
          diasFechaCorta: politica && politica.buenaACorta!=null ? politica.buenaACorta : '',
          diasAveria: politica && politica.cortaAAveria!=null ? politica.cortaAAveria : 5,
          fechaEsFabricacion: !!(politica && politica.fechaEsFabricacion),
          vidaUtilAnios: politica && politica.vidaUtilAnios!=null ? politica.vidaUtilAnios : null,
          diga: row['DIGA']||'',
          conteo1:'', conteo2:'', conteo3:'', supervisor:''
        },
        tiempos: { 1: crearTiempoVacio(), 2: crearTiempoVacio(), 3: crearTiempoVacio() }
      };
    }
    ciclicos[id].filas.push(row);
  });
}

function llenarFiltros(){
  const almacenes = [...new Set(Object.values(ciclicos).map(c=>c.almacen))].sort();
  const ubicaciones = [...new Set(Object.values(ciclicos).map(c=>c.ubicacion))].sort();
