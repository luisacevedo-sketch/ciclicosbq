/* =================================================================
   TRABAJO SIN INTERNET (offline) Y RESPALDO LOCAL
   -----------------------------------------------------------------
   Idea: si la señal se cae o está débil, nadie debe perder lo que ya
   digitó. Para eso hay DOS capas de seguridad que trabajan juntas:

   1) Persistencia offline de Firestore: los cambios que se guardan
      sin internet quedan en una caché local del navegador (IndexedDB)
      y Firestore los sube solo, automáticamente, en cuanto vuelve la
      conexión — sin que nadie tenga que hacer nada.
   2) Respaldo local extra (localStorage): una segunda copia de
      seguridad de todo el trabajo, por si el navegador no soporta la
      caché de Firestore (modo incógnito, navegador muy viejo, etc.)
      o si la pestaña se cierra antes de que la sincronización con la
      nube alcance a completarse.
   ================================================================= */
const CLAVE_RESPALDO_LOCAL = 'ciclicos_altipal_respaldo';
let respaldoLocalTimer = null;

function guardarRespaldoLocal(){
  clearTimeout(respaldoLocalTimer);
  respaldoLocalTimer = setTimeout(()=>{
    try{
      localStorage.setItem(CLAVE_RESPALDO_LOCAL, JSON.stringify({
        sesionId, usuarioActual, ciclicos, guardadoEn: new Date().toISOString()
      }));
    }catch(err){ console.warn('No se pudo guardar el respaldo local:', err); }
  }, 400); // pequeña pausa para no escribir en cada tecla, sin perder nada relevante
}

function guardarRespaldoLocalInmediato(){
  clearTimeout(respaldoLocalTimer);
  try{
    localStorage.setItem(CLAVE_RESPALDO_LOCAL, JSON.stringify({
      sesionId, usuarioActual, ciclicos, guardadoEn: new Date().toISOString()
    }));
  }catch(err){ console.warn('No se pudo guardar el respaldo local:', err); }
}

// Si al iniciar sesión Firestore todavía no ha traído nada (por ejemplo, se abrió
// la app estando sin internet), esto recupera el último respaldo guardado en este
// mismo dispositivo para que el trabajo nunca aparezca en blanco.
function restaurarRespaldoLocalSiAplica(){
  try{
    const crudo = localStorage.getItem(CLAVE_RESPALDO_LOCAL);
    if(!crudo) return;
    const respaldo = JSON.parse(crudo);
    if(!respaldo || !respaldo.ciclicos || respaldo.sesionId !== sesionId) return;
    if(Object.keys(ciclicos).length) return; // ya hay datos en memoria, no se sobreescribe
    if(!Object.keys(respaldo.ciclicos).length) return;

    ciclicos = respaldo.ciclicos;
    llenarFiltros();
    renderListaCiclicos(Object.values(ciclicos));
    document.getElementById('estadoSync').innerText =
      '♻ Se restauró el trabajo guardado en este dispositivo (' + new Date(respaldo.guardadoEn).toLocaleString('es-CO') + '). Verificando con la nube...';
  }catch(err){ console.warn('No se pudo restaurar el respaldo local:', err); }
}

// Muestra/oculta el aviso de "sin conexión" y actualiza el texto de estado.
function actualizarEstadoConexion(){
  const banner = document.getElementById('bannerSinConexion');
  if(banner) banner.style.display = navigator.onLine ? 'none' : 'flex';
  if(!navigator.onLine){
    document.getElementById('estadoSync').innerText =
      '📴 Sin conexión — trabajando localmente, se sincronizará solo cuando vuelva el internet.';
  } else if(firebaseListo() && db){
    document.getElementById('estadoSync').innerText = `🔄 Sesión: ${sesionId} · Conectado como ${usuarioActual}`;
  }
}

window.addEventListener('online', actualizarEstadoConexion);
window.addEventListener('offline', actualizarEstadoConexion);
// Si se cierra o recarga la pestaña, se fuerza a guardar el respaldo ya mismo
// (sin esperar la pequeña pausa de guardarRespaldoLocal) para no perder nada.
window.addEventListener('beforeunload', guardarRespaldoLocalInmediato);

function firebaseListo(){
  return firebaseConfig.apiKey && firebaseConfig.apiKey !== 'TU_API_KEY';
}

function idDoc(id){
  // Firestore no permite "/" en el id del documento
  return String(id).replace(/\//g, '__');
}

// Convierte los Timestamp de Firestore de vuelta a Date de JS (para que
// las columnas de fecha sigan funcionando igual que con el Excel original).
function normalizarFechasFila(fila){
  if(fila && fila['Fecha'] && typeof fila['Fecha'].toDate === 'function'){
    fila['Fecha'] = fila['Fecha'].toDate();
  }
  return fila;
}

function iniciarSincronizacion(){
  if(!firebaseListo()){
    document.getElementById('estadoSync').innerText = '⚠ Sincronización no configurada (modo local, un solo dispositivo).';
    return;
  }
  if(!firebaseApp){
    firebaseApp = firebase.initializeApp(firebaseConfig);
    db = firebase.firestore();
    // Habilita la caché offline de Firestore: si la señal se cae, todo lo que se
    // digite queda guardado en este dispositivo (IndexedDB) y se sube solo, en
    // orden, en cuanto vuelva la conexión. No hay que hacer nada manualmente.
    db.enablePersistence({synchronizeTabs:true}).catch(err=>{
      if(err.code === 'failed-precondition'){
        console.warn('Persistencia offline no disponible: hay otra pestaña de esta app abierta.');
      } else if(err.code === 'unimplemented'){
        console.warn('Este navegador no soporta almacenamiento offline de Firestore; se usará solo el respaldo local.');
      }
    });
  }
  actualizarEstadoConexion();

  if(unsubscribeCiclicos) unsubscribeCiclicos();
  unsubscribeCiclicos = db.collection('sesiones').doc(sesionId).collection('ciclicos')
    .onSnapshot({includeMetadataChanges:true}, snapshot=>{
      sincronizando = true;
      snapshot.docChanges().forEach(change=>{
        const data = change.doc.data();
        if(change.type === 'removed'){ delete ciclicos[change.doc.id]; return; }
        if(data && Array.isArray(data.filas)) data.filas.forEach(normalizarFechasFila);
        ciclicos[change.doc.id] = data;
      });
      sincronizando = false;
      guardarRespaldoLocal(); // mantiene el respaldo local al día con lo que llega de la nube

      // Refresca lo que se esté viendo en pantalla en este momento
      if(!document.getElementById('vistaCiclicos').classList.contains('oculto')){
        llenarFiltros();
        renderListaCiclicos(Object.values(ciclicos));
      }
      if(ciclicoActualId && ciclicos[ciclicoActualId] && !document.getElementById('vistaConteo').classList.contains('oculto')){
        pintarTablaConteo(ciclicos[ciclicoActualId]);
        actualizarBotonResaltar(ciclicos[ciclicoActualId]);
        asegurarTiempos(ciclicos[ciclicoActualId]);
        [1,2,3].forEach(actualizarEstadoTiempo);
      }
      if(!document.getElementById('vistaDashboard').classList.contains('oculto')) pintarDashboard();
      if(!document.getElementById('vistaDiferencias').classList.contains('oculto')) pintarTablaDiferencias();
      if(!document.getElementById('vistaKPI').classList.contains('oculto')) pintarKPI();

      // Estado visible de sincronización, incluyendo cambios que quedaron
      // pendientes de subir (por ejemplo, mientras la red estuvo débil o caída).
      if(!navigator.onLine){
        document.getElementById('estadoSync').innerText =
          '📴 Sin conexión — trabajando localmente, se sincronizará solo cuando vuelva el internet.';
      } else if(snapshot.metadata.hasPendingWrites){
        document.getElementById('estadoSync').innerText = '🔄 Sincronizando cambios pendientes con la nube...';
      } else {
        document.getElementById('estadoSync').innerText = `✅ Sincronizado · Sesión: ${sesionId} · Usuario: ${usuarioActual}`;
      }
    }, err=>{
      document.getElementById('estadoSync').innerText = '⚠ Error de sincronización: ' + err.message;
    });
}

// Sube (o actualiza) un cíclico completo en la nube. Se llama cada vez
// que alguien cambia un dato de ese cíclico (conteo, fecha, lote, etc.)
function guardarCiclicoEnNube(c){
  guardarRespaldoLocal(); // primero queda en este dispositivo, pase lo que pase con la red
  if(!firebaseListo() || !db || sincronizando) return;
  c._ultimoEditor = usuarioActual || '';
  c._ultimaEdicion = new Date().toISOString();
  db.collection('sesiones').doc(sesionId).collection('ciclicos').doc(idDoc(c.id))
    .set(c, {merge:true})
    .catch(err=> console.error('Error guardando en la nube:', err));
}

function subirTodosLosCiclicosANube(){
  guardarRespaldoLocalInmediato();
  if(!firebaseListo() || !db) return;
  const batch = db.batch();
  Object.values(ciclicos).forEach(c=>{
    const ref = db.collection('sesiones').doc(sesionId).collection('ciclicos').doc(idDoc(c.id));
    batch.set(ref, c, {merge:true});
  });
  batch.commit().catch(err=> console.error('Error subiendo cíclicos a la nube:', err));
}

