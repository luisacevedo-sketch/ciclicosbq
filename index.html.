      asegurarTiempos(c);
      const duracionCiclo = calcularDuracionCiclo(c);
      const completo = [1,2,3].every(n=> c.tiempos[n].historial.length && !c.tiempos[n].corriendo);
      return `<tr>
        <td style="text-align:left;">${c.nombre}</td>
        <td>${c.almacen}</td>
        <td>${c.ubicacion}</td>
        <td>${celdaPersona(c,1)}</td>
        <td>${celdaPersona(c,2)}</td>
        <td>${celdaPersona(c,3)}</td>
        <td>${duracionCiclo!=null ? formatDuracion(duracionCiclo) : '—'}</td>
        <td>${completo ? '✔ Completo' : '⏳ En proceso'}</td>
      </tr>`;
    });

  body.innerHTML = filas.length ? filas.join('') : `<tr><td colspan="8" style="padding:14px;color:#888;">No hay cíclicos que coincidan.</td></tr>`;
}

function pintarTablaConteo(c){
  const cols = ['Nombre','Código de artículo','Número de variante','Factor','Tipo','Código de barras',
    'Cod. Barras caja','Nombre del producto','Almacén','Ubicación','CONTADO TOTAL']
    .concat(REGISTRO_LABELS);
  const numIdCols = cols.length - REGISTRO_LABELS.length; // columnas de identificación antes de los registros
  const COLUMNAS_FIJAS = ['Código de artículo','Número de variante','Factor'];

  document.getElementById('headConteo').innerHTML = cols.map(h=>{
    const cls = COLUMNAS_FIJAS.includes(h) ? 'headTabla col-fija' : 'headTabla';
    return `<th class="${cls}">${h}</th>`;
  }).join('');

  // Buscador de producto: filtra por Código de artículo o Nombre del producto,
  // sin perder de cuál posición real (i) es cada fila dentro de c.filas.
  const inputBusqueda = document.getElementById('buscarProductoConteo');
  const filtro = inputBusqueda ? inputBusqueda.value.trim().toLowerCase() : '';
  let coincidencias = 0;

  const body = document.getElementById('bodyConteo');
  body.innerHTML = '';
  c.filas.forEach((f,i)=>{
    if(filtro){
      const texto = (
        String(f['Código de artículo']||'') + ' ' +
        String(f['Número de variante']||'') + ' ' +
        String(f['Nombre del producto']||'') + ' ' +
        String(f['Cod. Barras caja']||'') + ' ' +
        String(f['Código de barras']||'')
      ).toLowerCase();
      if(!texto.includes(filtro)) return;
    }
    coincidencias++;

    const codigo = f['Código de artículo'];
    asegurarRegistros(f);
    const total = f._registros.reduce((a,v)=> a + (Number(v)||0), 0);
    const disponible = Number(f['Disponible'])||0;
    const dif = total - disponible;

    const tr = document.createElement('tr');
    // "Resaltar diferencias" solo marca visualmente la fila (c._resaltado), sin decir cuánto es.
    if(c._resaltado && dif !== 0) tr.classList.add('fila-diferencia');

    // El "Disponible" del sistema y el número exacto de la diferencia NUNCA se muestran a quien
    // está contando. Solo aparecen si el supervisor los revela con su clave (c._diferenciasReveladas).
    const difTxt = (c._diferenciasReveladas && dif!==0) ? `(dif: ${dif>0?'+':''}${dif})` : '';

    let html = `<td>${f['Nombre']}</td>
      <td class="col-fija">${codigo}</td>
      <td class="col-fija">${f['Número de variante']}</td>
      <td class="col-fija">${f['Factor']}</td>
      <td>${f['Tipo']}</td><td>${f['Código de barras']}</td>
      <td>${f['Cod. Barras caja']}</td><td style="text-align:left;">${f['Nombre del producto']}</td>
      <td>${f['Almacén']}</td><td>${f['Ubicación']}</td>
      <td><b>${total}</b> ${difTxt}</td>`;

    f._registros.forEach((val, ridx)=>{
      html += `<td><input class="registro-input" type="number" value="${val}"
        onchange="actualizarRegistro('${c.id.replace(/'/g,"\\'")}', ${i}, ${ridx}, this.value)"></td>`;
    });
    tr.innerHTML = html;
    body.appendChild(tr);

    // Fila auxiliar: fecha de vencimiento para cada columna PICKING/PICKING2/ALTURA1-8
    const trFecha = document.createElement('tr');
    trFecha.classList.add('fila-altura-extra');
    const etiquetaFecha = c.header.fechaEsFabricacion ? 'Fecha de fabricación:' : 'Fecha de vencimiento:';
    let htmlFecha = `<td colspan="${numIdCols}" style="text-align:right;background:#fff;font-weight:bold;color:var(--azul-oscuro);">${etiquetaFecha}</td>`;
    f._registrosFecha.forEach((val, ridx)=>{
      const colorFondo = colorFechaCorta(val, c.header.diasAveria, c.header.diasFechaCorta, c.header.fechaEsFabricacion, c.header.vidaUtilAnios);
      htmlFecha += `<td style="background:${colorFondo||'#fff'};">
        <input type="date" class="venc-input" value="${val||''}"
          onchange="actualizarRegistroFecha('${c.id.replace(/'/g,"\\'")}', ${i}, ${ridx}, this.value)"></td>`;
    });
    trFecha.innerHTML = htmlFecha;
    body.appendChild(trFecha);

    // Fila auxiliar: lote para cada columna PICKING/PICKING2/ALTURA1-8
    const trLote = document.createElement('tr');
    trLote.classList.add('fila-altura-extra');
    let htmlLote = `<td colspan="${numIdCols}" style="text-align:right;background:#fff;font-weight:bold;color:var(--azul-oscuro);">Lote:</td>`;
    f._registrosLote.forEach((val, ridx)=>{
      htmlLote += `<td><input type="text" class="venc-input" placeholder="Lote" value="${val||''}"
        onchange="actualizarRegistroLote('${c.id.replace(/'/g,"\\'")}', ${i}, ${ridx}, this.value)"></td>`;
    });
    trLote.innerHTML = htmlLote;
    body.appendChild(trLote);
  });

  if(inputBusqueda){
    document.getElementById('contadorBusquedaConteo').innerText = filtro
      ? `${coincidencias} de ${c.filas.length} productos`
      : '';
  }
  if(filtro && coincidencias === 0){
    body.innerHTML = `<tr><td colspan="${cols.length}" style="padding:14px;color:#888;">No se encontró ningún producto con "${filtro}".</td></tr>`;
  }

  fijarColumnasConteo();
}

// Calcula el ancho real (ya renderizado) de cada columna inmovilizada y le asigna
// su posición "left" correspondiente, tanto en el encabezado como en cada fila,
// para que Código de artículo, Número de variante y Factor queden siempre visibles
// al desplazarse hacia la derecha.
function fijarColumnasConteo(){
  const headerFijas = document.querySelectorAll('#headConteo th.col-fija');
  if(!headerFijas.length) return;

  const anchos = [];
  let acumulado = 0;
  headerFijas.forEach(th=>{
    th.style.left = acumulado + 'px';
    const w = th.getBoundingClientRect().width;
    anchos.push(w);
    acumulado += w;
  });

  document.querySelectorAll('#bodyConteo tr').forEach(tr=>{
    const celdas = tr.querySelectorAll('td.col-fija');
    let acc = 0;
    celdas.forEach((td, idx)=>{
      td.style.left = acc + 'px';
      const w = anchos[idx] !== undefined ? anchos[idx] : td.getBoundingClientRect().width;
      acc += w;
    });
  });
}

