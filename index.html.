function claseFecha(fechaVal, diasAveria, diasFechaCorta, fechaEsFabricacion, vidaUtilAnios){
  if(!fechaVal) return '';
  const fecha = fechaVal instanceof Date ? fechaVal : new Date(fechaVal);
  if(isNaN(fecha)) return '';
  // Si la fecha digitada es de FABRICACIÓN (no de vencimiento), se le suma la vida útil
  // del proveedor (en años) para obtener la fecha de vencimiento real antes de comparar.
  if(fechaEsFabricacion && vidaUtilAnios){
    fecha.setFullYear(fecha.getFullYear() + Number(vidaUtilAnios));
  }
  const hoy = new Date(); hoy.setHours(0,0,0,0);
  const diffDias = Math.floor((fecha - hoy) / 86400000);
  const dAveria = Number(diasAveria);
  const dCorta = Number(diasFechaCorta);
  // Política Altipal por proveedor: rojo = dentro del rango de avería;
  // amarillo = dentro del rango de fecha corta (avería + buena-a-corta); verde = buena fecha.
  if(!isNaN(dAveria) && diffDias <= dAveria) return 'fila-rojo';
  if(!isNaN(dAveria) && !isNaN(dCorta) && diffDias <= (dAveria + dCorta)) return 'fila-amarillo';
  if(isNaN(dAveria) && !isNaN(dCorta) && diffDias <= dCorta) return 'fila-amarillo';
  if(!isNaN(dAveria) || !isNaN(dCorta)) return 'fila-verde';
  // Sin política conocida para el proveedor: se usan rangos genéricos de respaldo.
  if(diffDias <= 5) return 'fila-rojo';
  if(diffDias <= 30) return 'fila-amarillo';
  if(diffDias <= 60) return 'fila-azul';
  return 'fila-verde';
}

function colorFechaCorta(fechaStr, diasAveria, diasFechaCorta, fechaEsFabricacion, vidaUtilAnios){
  const clase = claseFecha(fechaStr, diasAveria, diasFechaCorta, fechaEsFabricacion, vidaUtilAnios);
  if(clase==='fila-rojo') return '#F8A9A9';
  if(clase==='fila-amarillo') return '#FFF2A8';
  if(clase==='fila-azul') return '#A9C9F8';
  if(clase==='fila-verde') return '#B7E6B0';
  return '';
}

// Si un cíclico ya tenía datos guardados (en esta sesión o sincronizados desde la nube)
// de antes de ampliar a PICKING2 y ALTURA7/ALTURA8, sus arreglos de registros quedan
// más cortos que NUM_REGISTROS. Esta función los completa con '' hasta la nueva
// longitud, para que las columnas nuevas siempre aparezcan (con su fecha, lote y color).
function asegurarRegistros(f){
  ['_registros','_registrosFecha','_registrosLote'].forEach(key=>{
    if(!Array.isArray(f[key])) f[key] = [];
    while(f[key].length < NUM_REGISTROS) f[key].push('');
  });
}

/* ---------------- KPI DE CONTEO (TIEMPOS POR PERSONA) ---------------- */
// Cada cíclico guarda, para cada uno de los 3 responsables (1,2,3):
// { corriendo:bool, inicio:ISOString|null, persona:string, historial:[{persona,inicio,fin,segundos}] }
// El "historial" permite que, si la misma persona (u otra) vuelve a contar esa
// misma hoja más adelante, quede un nuevo registro sin perder el anterior.
function crearTiempoVacio(){
  return { corriendo:false, inicio:null, persona:'', historial:[] };
}

// Compatibilidad: cíclicos creados antes de esta función (cargados de la nube
// o de una sesión vieja) no tienen "tiempos" todavía, así que se completan aquí.
function asegurarTiempos(c){
  if(!c.tiempos) c.tiempos = {};
  [1,2,3].forEach(n=>{
    if(!c.tiempos[n]) c.tiempos[n] = crearTiempoVacio();
    if(!Array.isArray(c.tiempos[n].historial)) c.tiempos[n].historial = [];
  });
}

function formatDuracion(segundosTotal){
  segundosTotal = Math.max(0, Math.round(segundosTotal||0));
  const h = Math.floor(segundosTotal/3600);
  const m = Math.floor((segundosTotal%3600)/60);
  const s = segundosTotal%60;
  if(h>0) return `${h}h ${m}m`;
  if(m>0) return `${m}m ${s}s`;
  return `${s}s`;
}

function obtenerPersonaSeleccionada(numero){
  const sel = document.getElementById('hConteo'+numero);
  const otro = document.getElementById('hConteo'+numero+'Otro');
  if(!sel) return '';
  return sel.value === 'OTROS' ? (otro ? otro.value.trim() : '') : sel.value;
}

function iniciarConteoPersona(numero){
  const c = ciclicos[ciclicoActualId];
  if(!c) return;
  asegurarTiempos(c);
  const t = c.tiempos[numero];
  if(t.corriendo){ alert('Ya hay un conteo en curso para este responsable en este cíclico.'); return; }
  const persona = obtenerPersonaSeleccionada(numero);
  if(!persona){ alert('Primero selecciona el responsable de este conteo (Conteo #' + numero + ').'); return; }
  t.persona = persona;
  t.inicio = new Date().toISOString();
  t.corriendo = true;
  actualizarEstadoTiempo(numero);
  guardarCiclicoEnNube(c);
}

function finalizarConteoPersona(numero){
  const c = ciclicos[ciclicoActualId];
  if(!c) return;
  asegurarTiempos(c);
  const t = c.tiempos[numero];
  if(!t.corriendo){ alert('No hay un conteo en curso para finalizar en este responsable.'); return; }
  const fin = new Date();
  const inicio = new Date(t.inicio);
  const segundos = Math.max(0, Math.round((fin - inicio)/1000));
  t.historial.push({ persona: t.persona, inicio: t.inicio, fin: fin.toISOString(), segundos });
  t.corriendo = false;
  t.inicio = null;
  actualizarEstadoTiempo(numero);
  guardarCiclicoEnNube(c);
}

function actualizarEstadoTiempo(numero){
  const c = ciclicos[ciclicoActualId];
  const span = document.getElementById('estadoTiempo'+numero);
  const btnIniciar = document.getElementById('btnIniciarTiempo'+numero);
  const btnFinalizar = document.getElementById('btnFinalizarTiempo'+numero);
  if(!c || !span || !btnIniciar || !btnFinalizar) return;
  asegurarTiempos(c);
  const t = c.tiempos[numero];
  const totalHistorial = t.historial.reduce((a,s)=> a + (s.segundos||0), 0);

  if(t.corriendo){
    const horaInicio = new Date(t.inicio).toLocaleTimeString('es-CO', {hour:'2-digit', minute:'2-digit'});
    span.innerHTML = `🟢 En curso desde ${horaInicio}`;
    btnIniciar.classList.add('oculto');
    btnFinalizar.classList.remove('oculto');
  } else {
    span.innerHTML = t.historial.length
      ? `✔ ${t.historial.length} conteo(s) · ${formatDuracion(totalHistorial)} en total`
      : 'Sin iniciar';
    btnIniciar.classList.remove('oculto');
    btnFinalizar.classList.add('oculto');
  }
}

